# --- Required ---
# Token from @BotFather. Keep it secret, never commit the real value.
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# --- Database ---
# SQLite (default, good for a single VPS / low traffic):
DATABASE_URL=sqlite+aiosqlite:///./data/starprivacy.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/starprivacy

# --- Storage ---
# Local folder where downloaded media (photos/videos/voice/documents) is cached.
MEDIA_STORAGE_PATH=./data/media

# --- Access control ---
# Extra admins (besides the permanent hardcoded lifetime-free admin), comma separated Telegram user IDs.
EXTRA_ADMIN_IDS=

# --- Logging ---
LOG_LEVEL=INFO

# --- Mini App web server ---
# Bind address/port for the aiohttp server (webapp/). Defaults to 0.0.0.0 so it
# works both behind your own reverse proxy (VPS: Caddy/nginx with real TLS)
# and on PaaS platforms (Railway/Render) that inject PORT automatically and
# forward public HTTPS traffic to it - Telegram requires Mini App URLs to be
# HTTPS on a public domain. Leave both unset on Railway/Render.
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
